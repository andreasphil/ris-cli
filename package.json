{
  "name": "ris-cli",
  "version": "0.1.0",
  "description": "Command line client for the RIS API (rechtsinformationen.bund.de)",
  "license": "MIT",
  "bin": {
    "ris": "./bin/ris.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "node --experimental-strip-types src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sync-spec": "node --experimental-strip-types scripts/sync-spec.ts",
    "generate-api-types": "openapi-typescript spec/openapi.json -o src/types/api.d.ts",
    "fmt": "oxfmt --no-error-on-unmatched-pattern",
    "lint": "oxlint --fix --no-error-on-unmatched-pattern",
    "style:check": "oxfmt --check && oxlint --max-warnings=0",
    "style:fix": "pnpm fmt && pnpm lint"
  },
  "dependencies": {
    "citty": "0.2.2"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.5.1"
}
